---
import BaseLayout from '~/layouts/BaseLayout.astro'
import PageHero from '~/components/sections/PageHero.astro'
import CompanyTable from '~/components/sections/company/CompanyTable.astro'
import Members from '~/components/sections/company/Members.astro'
import Omeload from '~/components/sections/company/Omeload.astro'
import { companyHero } from '~/data/company'
---

<BaseLayout
  title="会社概要・理念"
  description="omeroid の理念・行動指針 omeload・経営メンバー・会社概要。コンサルタントとエンジニアが同じ屋根の下で働くプロフェッショナル集団です。"
>
  <PageHero
    eyebrow={companyHero.eyebrow}
    title={companyHero.title}
    lead={companyHero.lead}
    blobs="company"
    align="center"
  />

  <Omeload />
  <Members />
  <CompanyTable />
</BaseLayout>
