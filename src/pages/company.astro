---
import BaseLayout from '~/layouts/BaseLayout.astro'
import ContactCta from '~/components/sections/ContactCta.astro'
import PageHero from '~/components/sections/PageHero.astro'
import CompanyTable from '~/components/sections/company/CompanyTable.astro'
import Members from '~/components/sections/company/Members.astro'
import Omeload from '~/components/sections/company/Omeload.astro'
import PictureRow from '~/components/ui/PictureRow.astro'
import Section from '~/components/ui/Section.astro'
import { companyHero, officePictures } from '~/data/company'
---

<BaseLayout
  title="会社概要・理念"
  description="omeroid は 2019年、松野・清田・和田の3名で創業。自己資本のみで経営し、コンサルタントとエンジニアが同じ屋根の下で働くプロフェッショナル集団です。"
>
  <PageHero
    eyebrow={companyHero.eyebrow}
    title={companyHero.title}
    lead={companyHero.lead}
    blobs="company"
    align="center"
  />

  <Section flush="top">
    <PictureRow
      pictures={officePictures}
      columns="repeat(2, minmax(0, 1fr))"
      height="clamp(220px, 28vw, 400px)"
      radius="10px"
    />
  </Section>

  <Omeload />
  <Members />
  <CompanyTable />
  <ContactCta />
</BaseLayout>
