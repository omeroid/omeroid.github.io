---
import BaseLayout from '~/layouts/BaseLayout.astro'
import ContactCta from '~/components/sections/ContactCta.astro'
import Faq from '~/components/sections/Faq.astro'
import Issues from '~/components/sections/Issues.astro'
import MenuList from '~/components/sections/MenuList.astro'
import PageHero from '~/components/sections/PageHero.astro'
import Strength from '~/components/sections/Strength.astro'
import Works from '~/components/sections/Works.astro'
import Contents from '~/components/sections/consulting/Contents.astro'
import Process from '~/components/sections/consulting/Process.astro'
import {
  consultingFaqs,
  consultingHero,
  consultingIssues,
  consultingMenu,
  consultingMenuHeading,
  consultingStrengthCards,
  consultingStrengthHeading,
  consultingWorks,
  consultingWorksFilterLabels,
  consultingWorksFootnotes,
  consultingWorksHeading,
  consultingWorksListHeading,
  consultingWorkStats,
} from '~/data/consulting'
---

<BaseLayout
  title="戦略・業務コンサルティング"
  description="経営・業務戦略、DX・AI戦略、データ戦略の3テーマで伴走。エンジニアが同じ社内にいるからこそ、実装可能な戦略を描き、実行まで見届けます。"
>
  <PageHero
    eyebrow={consultingHero.eyebrow}
    title={consultingHero.title}
    lead={consultingHero.lead}
    cta={consultingHero.cta}
    ctaNote={consultingHero.ctaNote}
    blobs="consulting"
  />

  {
    /* 背景はヒーローから bg / alt を交互に切り替える（順番を変えるときは surface も直す） */
  }
  <Issues {...consultingIssues} surface="alt" />
  <MenuList
    heading={consultingMenuHeading}
    rows={consultingMenu}
    surface="bg"
  />
  <Strength
    heading={consultingStrengthHeading}
    cards={consultingStrengthCards}
    surface="alt"
  />
  <Works
    heading={consultingWorksHeading}
    layout="cards"
    stats={consultingWorkStats}
    listHeading={consultingWorksListHeading}
    filterLabels={consultingWorksFilterLabels}
    works={consultingWorks}
    footnotes={consultingWorksFootnotes}
    surface="bg"
  />
  <Process surface="alt" />
  <Contents surface="bg" />
  <Faq items={consultingFaqs} surface="alt" />
  <ContactCta surface="bg" />
</BaseLayout>
