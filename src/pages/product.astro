---
import BaseLayout from '~/layouts/BaseLayout.astro'
import ContactCta from '~/components/sections/ContactCta.astro'
import PageHero from '~/components/sections/PageHero.astro'
import ProductRows from '~/components/sections/product/ProductRows.astro'
import { productHero } from '~/data/product'
---

<BaseLayout
  title="自社プロダクト"
  description="社内R&D制度「RoiD」から生まれたものも、お客様との協業から育ったものも。omeroid が自分たちで手がけているプロダクトを紹介します。"
>
  <PageHero
    eyebrow={productHero.eyebrow}
    title={[productHero.title]}
    lead={productHero.lead}
    blobs="product"
    size="md"
  />
  <ProductRows />
  <ContactCta />
</BaseLayout>
