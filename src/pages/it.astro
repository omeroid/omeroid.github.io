---
import BaseLayout from '~/layouts/BaseLayout.astro'
import ContactCta from '~/components/sections/ContactCta.astro'
import Faq from '~/components/sections/Faq.astro'
import PageHero from '~/components/sections/PageHero.astro'
import Process from '~/components/sections/Process.astro'
import Stack from '~/components/sections/Stack.astro'
import Strength from '~/components/sections/Strength.astro'
import Works from '~/components/sections/Works.astro'
import Issues from '~/components/sections/it/Issues.astro'
import MenuList from '~/components/sections/it/MenuList.astro'
import Picture from '~/components/ui/Picture.astro'
import Section from '~/components/ui/Section.astro'
import { itHero } from '~/data/it'
---

<BaseLayout
  title="ITコンサルティング・システム開発"
  description="要件定義から設計・フルスクラッチ開発・運用まで一気通貫。「何をつくるべきか」から一緒に決める開発会社です。IT戦略策定・社内DX推進・システム開発・内製化支援・運用保守を提供します。"
>
  <PageHero
    eyebrow={itHero.eyebrow}
    title={itHero.title}
    lead={itHero.lead}
    cta={itHero.cta}
    ctaNote={itHero.ctaNote}
    blobs="it"
  />

  <Section flush="top">
    <Picture
      picture={itHero.picture}
      height="clamp(220px, 30vw, 420px)"
      radius="10px"
      sizes="(max-width: 1400px) 100vw, 1400px"
      loading="eager"
      reveal={0}
    />
  </Section>

  <Issues />
  <MenuList />
  <Strength />
  <Works />
  <Process />
  <Stack />
  <Faq />
  <ContactCta />
</BaseLayout>
