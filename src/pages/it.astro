---
import BaseLayout from '~/layouts/BaseLayout.astro'
import ContactCta from '~/components/sections/ContactCta.astro'
import Faq from '~/components/sections/Faq.astro'
import Issues from '~/components/sections/Issues.astro'
import MenuList from '~/components/sections/MenuList.astro'
import PageHero from '~/components/sections/PageHero.astro'
import Stack from '~/components/sections/Stack.astro'
import Strength from '~/components/sections/Strength.astro'
import Works from '~/components/sections/Works.astro'
import { faqs } from '~/data/faq'
import { itHero, itIssues, itMenu, itMenuHeading } from '~/data/it'
import { strengthCards, strengthHeading } from '~/data/strength'
import {
  works,
  worksFilterLabels,
  worksFootnotes,
  worksHeading,
  worksListHeading,
  workStats,
} from '~/data/works'
---

<BaseLayout
  title="ITコンサルティング・システム開発"
  description="要件定義から設計・フルスクラッチ開発・運用まで一気通貫。ビジネスを支えるITパートナーになれる開発会社です。IT戦略策定・社内DX推進・システム開発・内製化支援・運用保守を提供します。"
>
  <PageHero
    eyebrow={itHero.eyebrow}
    title={itHero.title}
    lead={itHero.lead}
    cta={itHero.cta}
    ctaNote={itHero.ctaNote}
    blobs="it"
  />

  {
    /* 背景はヒーローから bg / alt を交互に切り替える（順番を変えるときは surface も直す） */
  }
  <Issues {...itIssues} surface="alt" />
  <MenuList heading={itMenuHeading} rows={itMenu} surface="bg" />
  <Strength heading={strengthHeading} cards={strengthCards} surface="alt" />
  <Works
    heading={worksHeading}
    stats={workStats}
    listHeading={worksListHeading}
    filterLabels={worksFilterLabels}
    works={works}
    footnotes={worksFootnotes}
    surface="bg"
  />
  <Stack surface="alt" />
  <Faq items={faqs} surface="bg" />
  <ContactCta surface="alt" />
</BaseLayout>
