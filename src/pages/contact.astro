---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Blobs from '~/components/ui/Blobs.astro'
import ContactForm from '~/components/ui/ContactForm.astro'
import Eyebrow from '~/components/ui/Eyebrow.astro'
import { contactPage } from '~/data/contact'
import { site } from '~/data/site'
---

<BaseLayout
  title="お問い合わせ"
  description="要件が固まっていなくて構いません。初回30分のヒアリングは無料です。2営業日以内にご返信します。"
>
  <section class="contact">
    <Blobs preset="contact" />
    <div class="container contact__inner">
      <div>
        <Eyebrow label={contactPage.eyebrow} reveal={0} />
        <h1 class="heading contact__title" data-reveal="1">
          {
            contactPage.title.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))
          }
        </h1>
        <p class="lead contact__lead" data-reveal="2">{contactPage.lead}</p>

        <ol class="contact__steps" data-reveal="3">
          {
            contactPage.steps.map((step, i) => (
              <li>
                <span class="en contact__step-no">0{i + 1}</span>
                {step}
              </li>
            ))
          }
        </ol>

        <p class="contact__mail">
          お急ぎの場合は
          <a href={`mailto:${site.email}`}>{site.email}</a> まで直接ご連絡ください。
        </p>
      </div>

      <ContactForm variant="full" reveal={4} />
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    position: relative;
    overflow: hidden;
  }

  .contact__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(3.5rem, 2rem + 4vw, 6.75rem)
      clamp(4rem, 2rem + 5vw, 7.5rem);
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2.5rem, 1rem + 5vw, 5.25rem);
    align-items: start;
  }

  .contact__title {
    margin-top: 34px;
    font-size: clamp(1.875rem, 1.2rem + 2.8vw, 3rem);
    line-height: 1.62;
  }

  .contact__lead {
    margin-top: 34px;
  }

  .contact__steps {
    margin-top: 44px;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line-mid);
  }

  .contact__steps li {
    display: flex;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line-mid);
    font-size: 0.9375rem;
  }

  .contact__step-no {
    color: var(--c-accent);
  }

  .contact__mail {
    margin-top: 28px;
    font-size: 0.875rem;
    color: var(--ink-55);
  }

  @media (max-width: 900px) {
    .contact__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
