---
import { contactForm, contactTypes } from '~/data/contact'

/**
 * お問い合わせフォーム。
 * contactForm.endpoint が設定されていればそこへPOST、未設定なら
 * 入力内容をメール本文に展開してメールソフトを開く（静的サイトのため）。
 */
interface Props {
  reveal?: number
}

const { reveal } = Astro.props
const { endpoint, mailto, submitLabel } = contactForm
const isMailto = !endpoint
---

<form
  class="cform"
  method="post"
  action={endpoint ?? undefined}
  data-mailto={isMailto ? mailto : undefined}
  data-reveal={reveal}
>
  <select name="type" aria-label="お問い合わせ種別" class="cform__select">
    <option value="">{contactTypes.placeholder}</option>
    {
      contactTypes.options.map((option) => (
        <option value={option}>{option}</option>
      ))
    }
  </select>
  <input
    type="text"
    name="company"
    placeholder="会社名"
    aria-label="会社名"
    autocomplete="organization"
  />
  <input
    type="text"
    name="name"
    placeholder="お名前"
    aria-label="お名前"
    autocomplete="name"
    required
  />
  <input
    type="email"
    name="email"
    placeholder="メールアドレス"
    aria-label="メールアドレス"
    autocomplete="email"
    required
  />
  <textarea
    name="detail"
    rows="4"
    placeholder="ご相談内容（箇条書きで構いません）"
    aria-label="ご相談内容"
    required></textarea>

  <button type="submit" class="cform__submit">{submitLabel}</button>

  {
    isMailto && (
      <p class="cform__note">
        送信ボタンを押すとメールソフトの作成画面が開きます。開かない場合は
        <a href={`mailto:${mailto}`}>{mailto}</a> へ直接お送りください。
      </p>
    )
  }
</form>

<style>
  .cform {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(1.75rem, 1.2rem + 2vw, 2.875rem)
      clamp(1.5rem, 1rem + 1.8vw, 2.625rem);
    background: var(--c-white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  input[type='text'],
  input[type='email'],
  select,
  textarea {
    width: 100%;
    padding: 16px 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    background: var(--c-bg);
    color: var(--c-ink);
    outline: none;
    transition: border-color 200ms var(--ease);
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--c-accent);
  }

  /* 素の select は環境差が大きいので、矢印だけ自前で描く */
  .cform__select {
    appearance: none;
    cursor: pointer;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--ink-50) 50%),
      linear-gradient(135deg, var(--ink-50) 50%, transparent 50%);
    background-position:
      calc(100% - 22px) 50%,
      calc(100% - 16px) 50%;
    background-size:
      6px 6px,
      6px 6px;
    background-repeat: no-repeat;
  }

  .cform__submit {
    margin-top: 8px;
    padding: 19px;
    border-radius: var(--radius-pill);
    background: var(--c-ink);
    color: var(--c-bg);
    font-size: 0.9375rem;
    font-weight: 700;
    transition: background-color 220ms var(--ease);
  }

  .cform__submit:hover {
    background: var(--c-accent);
  }

  .cform__note {
    font-size: 0.75rem;
    line-height: 1.9;
    color: var(--ink-55);
  }
</style>

<script>
  // endpoint 未設定時は入力内容を mailto: に展開して送信する
  const LABELS: Record<string, string> = {
    type: 'お問い合わせ種別',
    company: '会社名',
    name: 'お名前',
    email: 'メールアドレス',
    detail: '詳細',
  }

  document
    .querySelectorAll<HTMLFormElement>('form[data-mailto]')
    .forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault()
        const to = form.dataset.mailto
        if (!to) return

        const data = new FormData(form)
        const lines = Object.keys(LABELS)
          .map((key) => {
            const values = data
              .getAll(key)
              .filter((v) => String(v).trim() !== '')
            return values.length
              ? `${LABELS[key]}: ${values.join(' / ')}`
              : null
          })
          .filter(Boolean)

        const subject = `【お問い合わせ】${data.get('name') || ''}`
        const url = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`
        window.location.href = url
      })
    })
</script>
