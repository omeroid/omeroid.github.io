---
import { stackIconColors } from '~/lib/stack-icon-colors'

/**
 * 技術スタックのアイコン。SVGは src/assets/icons/ に埋め込んであり、外部CDNへは接続しない。
 * アイコンを追加するときは `node scripts/generate-stack-icons.mjs` を実行する。
 */
interface Props {
  /** simple-icons のスラッグ（= src/assets/icons/<icon>.svg） */
  icon: string
  /** ブランドカラーではなく文字色で描画する（黒に近いロゴ用） */
  dark?: boolean
  /** 表示サイズ (px) */
  size?: number
}

const { icon, dark = false, size = 22 } = Astro.props

const files = import.meta.glob<string>('../../assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
})

const svg = files[`../../assets/icons/${icon}.svg`]
if (!svg) {
  throw new Error(
    `アイコン "${icon}" が src/assets/icons/ にありません。scripts/generate-stack-icons.mjs の ICON_SLUGS に追加して再生成してください。`
  )
}

const color = dark ? 'var(--c-ink)' : (stackIconColors[icon] ?? 'var(--c-ink)')
---

<span
  class="stack-icon"
  style={`--icon-size:${size}px;--icon-color:${color}`}
  set:html={svg}
/>

<style>
  .stack-icon {
    width: var(--icon-size);
    height: var(--icon-size);
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--icon-color);
  }

  .stack-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
