---
import type { AccentCard } from '~/types'
import GradientCard from './GradientCard.astro'

/** グラデーションカードの並び */
interface Props {
  cards: AccentCard[]
  cols?: 2 | 3 | 4
  titleSize?: 'lg' | 'md' | 'sm'
  strength?: number
  /** data-reveal の開始インデックス（見出しの後に続ける） */
  revealFrom?: number
  class?: string
}

const {
  cards,
  cols = 3,
  titleSize = 'md',
  strength = 0.22,
  revealFrom = 3,
  class: className,
} = Astro.props
---

<div class:list={['grid', `grid--${cols}`, className]}>
  {
    cards.map((card, i) => (
      <GradientCard
        {...card}
        titleSize={titleSize}
        strength={strength}
        reveal={revealFrom + i}
      />
    ))
  }
</div>
