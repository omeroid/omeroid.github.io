---
import CellGrid from '~/components/ui/CellGrid.astro'
import Section from '~/components/ui/Section.astro'
import SectionHead from '~/components/ui/SectionHead.astro'
import type { SectionHeading, Surface } from '~/types'

/** ISSUES（こんなご相談をいただいています）。IT事業・コンサルティングで使う */
interface Props {
  heading: SectionHeading
  items: string[]
  /** 最後の項目だけ全幅で配置する */
  wideLast?: boolean
  /** 乗せる面の色。ページ側の交互配色に合わせる */
  surface?: Surface
}

const { heading, items, wideLast = false, surface = 'alt' } = Astro.props
---

<Section variant={surface === 'alt' ? 'alt-cool' : 'default'}>
  <SectionHead
    {...heading}
    size="sm"
    gap="clamp(2.5rem, 1.5rem + 3vw, 3.5rem)"
  />
  <CellGrid
    items={items.map((body, i) => ({
      body,
      wide: wideLast && i === items.length - 1,
    }))}
    cols={3}
  />
</Section>
