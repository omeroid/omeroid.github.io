---
import Section from '~/components/ui/Section.astro'
import SectionHead from '~/components/ui/SectionHead.astro'
import type { SectionHeading, Surface, WorkRow, WorkStat } from '~/types'

/**
 * WORKS（実績）。IT事業・コンサルティングで、それぞれの実績を渡して使う。
 *
 * layout で見せ方が2種類ある。
 * ・rows  … 1件1行。支援期間の数値と期間バーを並べる（IT・システム開発）
 * ・cards … カードのグリッド。期間は出さない（コンサルティング）
 */
interface Props {
  heading: SectionHeading
  layout?: 'rows' | 'cards'
  stats: WorkStat[]
  /** legend（期間バーの凡例）は layout="rows" のみ */
  listHeading: { title: string; legend?: string; range: string }
  filterLabels: {
    lead: string
    all: string
    industry: { no: string; label: string; en: string }
    tag: { no: string; label: string; en: string }
  }
  works: WorkRow[]
  footnotes: string[]
  /** 乗せる面の色。数値タイル・絞り込み枠・カードは常に反対色になる */
  surface?: Surface
}

const {
  heading: worksHeading,
  layout = 'rows',
  stats: workStats,
  listHeading: worksListHeading,
  filterLabels: worksFilterLabels,
  works,
  footnotes: worksFootnotes,
  surface = 'bg',
} = Astro.props

/** 期間バーの基準になる最長プロジェクト */
const maxMonths = Math.max(...works.map((w) => w.months ?? 0), 1)

/** 90 → 7年6ヶ月 / 9 → 9ヶ月 */
const duration = (months: number) =>
  months < 12
    ? `${months}ヶ月`
    : `${Math.floor(months / 12)}年${months % 12}ヶ月`

/** 継続中は ONGOING、終了済みは年の範囲 */
const period = (row: (typeof works)[number]) =>
  row.end === undefined
    ? 'ONGOING'
    : row.end === row.start
      ? `${row.start}`
      : `${row.start} — ${row.end}`

/** 出現順に並べた絞り込みの選択肢と件数 */
const countBy = (pick: (row: (typeof works)[number]) => string[]) => {
  const counts = new Map<string, number>()
  for (const row of works) {
    for (const key of pick(row)) counts.set(key, (counts.get(key) ?? 0) + 1)
  }
  return [...counts].sort((a, b) => b[1] - a[1])
}

const industries = countBy((row) => [row.industry])
const tags = countBy((row) => row.tags)
---

<Section variant={surface === 'alt' ? 'alt' : 'default'} bordered>
  <SectionHead {...worksHeading} gap="clamp(2.5rem, 1.5rem + 3vw, 4rem)" />

  <div
    class="works"
    data-works
    style={`--works-surface:var(${surface === 'alt' ? '--c-bg-alt' : '--c-bg'})`}
  >
    <div
      class="works__stats"
      data-reveal="3"
      style={`--works-stat-cols:${workStats.length}`}
    >
      {
        workStats.map((stat) => (
          <div class:list={['works__stat', stat.featured && 'is-featured']}>
            <div class="en works__stat-label">{stat.label}</div>
            <div class="works__stat-value">
              <span class="en works__stat-num" data-countup={stat.value}>
                {stat.value}
              </span>
              {stat.suffix && (
                <span class="en works__stat-suffix">{stat.suffix}</span>
              )}
              <span class="works__stat-unit">{stat.unit}</span>
              {stat.value2 !== undefined && (
                <>
                  <span
                    class="en works__stat-num is-sub"
                    data-countup={stat.value2}
                  >
                    {stat.value2}
                  </span>
                  <span class="works__stat-unit">{stat.unit2}</span>
                </>
              )}
            </div>
            <div class="works__stat-note">{stat.note}</div>
          </div>
        ))
      }
    </div>

    <div class="works__list-head" data-reveal="4">
      <h3 class="works__list-title">{worksListHeading.title}</h3>
      <div class="en works__legend">
        {
          worksListHeading.legend && (
            <span class="works__legend-item">
              <span class="works__legend-bar" />
              {worksListHeading.legend}
            </span>
          )
        }
        <span>
          {worksListHeading.legend && '／ '}{worksListHeading.range}
        </span>
      </div>
    </div>

    <div class="works__filters" data-reveal="4">
      <div class="works__filters-head">
        <div class="works__filters-lead">
          {worksFilterLabels.lead}
          <span class="en works__count" data-works-count>
            {works.length} / {works.length}
          </span>
        </div>
        <button
          type="button"
          class="works__chip is-all is-on"
          data-filter="all:all"
        >
          {worksFilterLabels.all}
        </button>
      </div>

      {
        (
          [
            ['ind', worksFilterLabels.industry, industries],
            ['tag', worksFilterLabels.tag, tags],
          ] as const
        ).map(([kind, label, items]) => (
          <div class="works__filter-group">
            <div class="works__filter-label">
              <span class="en">
                {label.no} ／ {label.label}{' '}
                <span class="is-wide">{label.en}</span>
              </span>
              <span class="works__rule" />
            </div>
            <div class="works__chips">
              {items.map(([name, count]) => (
                <button
                  type="button"
                  class="works__chip"
                  data-filter={`${kind}:${name}`}
                >
                  {name}
                  <span class="en works__chip-count">{count}</span>
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {
      layout === 'rows' ? (
        <div class="works__rows" data-reveal="5">
          {works.map((row) => (
            <article
              class="works__row"
              data-ind={row.industry}
              data-tags={row.tags.join('|')}
            >
              <div>
                <div class="en works__category">{row.category}</div>
                <h4 class="works__client">{row.client}</h4>
                <div class="works__tags">
                  {row.tags.map((tag) => (
                    <span class="works__tag">{tag}</span>
                  ))}
                </div>
              </div>
              <p class="works__body">{row.body}</p>
              <div>
                <div class="works__duration">
                  <span class="works__months">{duration(row.months ?? 0)}</span>
                  <span
                    class:list={[
                      'en',
                      'works__period',
                      row.end === undefined && 'is-ongoing',
                    ]}
                  >
                    {period(row)}
                  </span>
                </div>
                <div class="works__track">
                  <div
                    class:list={[
                      'works__bar',
                      row.end === undefined && 'is-ongoing',
                    ]}
                    data-bar={Math.round(((row.months ?? 0) / maxMonths) * 100)}
                  />
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="works__cards" data-reveal="5">
          {works.map((row) => (
            <article
              class="works__card"
              data-ind={row.industry}
              data-tags={row.tags.join('|')}
            >
              <div class="en works__category">{row.category}</div>
              <h4 class="works__client">{row.client}</h4>
              <p class="works__body">{row.body}</p>
              <div class="works__tags">
                {row.tags.map((tag) => (
                  <span class="works__tag">{tag}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      )
    }

    <p class="works__empty" data-works-empty hidden>
      該当するプロジェクトがありません。
    </p>

    {
      worksFootnotes.map((note, i) => (
        <p class="works__footnote" data-reveal={6 + i}>
          {note}
        </p>
      ))
    }
  </div>
</Section>

<style>
  /* --- 数値タイル --- */
  .works__stats {
    display: grid;
    grid-template-columns: repeat(var(--works-stat-cols, 3), minmax(0, 1fr));
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .works__stat {
    background: var(--works-surface, var(--c-bg));
    padding: 34px 30px 30px;
  }

  .works__stat.is-featured {
    background: var(--c-accent);
    color: var(--c-bg);
  }

  .works__stat-label {
    font-size: 0.65625rem;
    letter-spacing: 0.2em;
    color: var(--ink-45);
  }

  .works__stat.is-featured .works__stat-label {
    color: color-mix(in srgb, var(--c-bg) 60%, transparent);
  }

  .works__stat-value {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 18px;
  }

  .works__stat-num {
    font-size: var(--fs-stat);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .works__stat-num.is-sub {
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
  }

  .works__stat-suffix {
    font-size: clamp(1.375rem, 0.95rem + 1.7vw, 2rem);
    font-weight: 500;
    line-height: 1;
  }

  .works__stat-unit {
    font-size: 0.9375rem;
    color: var(--ink-55);
  }

  .works__stat.is-featured .works__stat-unit {
    color: color-mix(in srgb, var(--c-bg) 72%, transparent);
  }

  .works__stat-note {
    margin-top: 14px;
    font-size: var(--fs-xs);
    line-height: 1.9;
    color: var(--c-text);
  }

  .works__stat.is-featured .works__stat-note {
    color: color-mix(in srgb, var(--c-bg) 80%, transparent);
  }

  /* --- 一覧の見出し --- */
  .works__list-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin: clamp(3rem, 2rem + 3vw, 5.5rem) 0 26px;
  }

  .works__list-title {
    font-family: var(--font-head);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .works__legend {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--ink-45);
  }

  .works__legend-item {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .works__legend-bar {
    width: 22px;
    height: 6px;
    border-radius: 3px;
    background: var(--c-accent);
    display: block;
  }

  /* --- 絞り込み --- */
  .works__filters {
    margin-bottom: 34px;
    padding: 30px 32px 32px;
    background: var(--works-surface, var(--c-bg));
    border: 1px solid var(--line-mid);
    border-radius: var(--radius);
  }

  .works__filters-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .works__filters-lead {
    font-size: 0.875rem;
    color: var(--c-text);
  }

  .works__count {
    margin-left: 12px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-45);
  }

  .works__filter-group + .works__filter-group {
    margin-top: 30px;
  }

  .works__filter-label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.65625rem;
    letter-spacing: 0.18em;
    color: var(--ink-45);
    white-space: nowrap;
  }

  .works__filter-label .is-wide {
    letter-spacing: 0.22em;
  }

  .works__rule {
    flex: 1;
    height: 1px;
    background: var(--line-mid);
    display: block;
  }

  .works__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }

  .works__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    font-size: var(--fs-xs);
    line-height: 1;
    color: var(--c-text);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease),
      border-color 200ms var(--ease);
  }

  .works__chip:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .works__chip.is-all {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .works__chip.is-all:hover {
    background: color-mix(in srgb, var(--c-accent) 8%, transparent);
  }

  .works__chip.is-on {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-bg);
  }

  .works__chip-count {
    font-size: 0.6875rem;
    opacity: 0.5;
  }

  /* --- 実績の行 --- */
  .works__rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .works__row {
    display: grid;
    grid-template-columns:
      minmax(210px, 1fr) minmax(240px, 1.45fr)
      minmax(200px, 0.9fr);
    align-items: center;
    gap: 32px;
    padding: 26px 30px;
    background: var(--works-surface, var(--c-bg));
    border: 1px solid var(--line-mid);
    border-radius: var(--radius-sm);
    transition:
      border-color 250ms var(--ease),
      box-shadow 250ms var(--ease),
      transform 250ms var(--ease);
  }

  .works__row:hover {
    border-color: color-mix(in srgb, var(--c-accent) 50%, transparent);
    box-shadow: 0 8px 22px rgba(22, 25, 28, 0.07);
    transform: translateY(-2px);
  }

  .works__row[hidden] {
    display: none;
  }

  /* --- 実績のカード（layout="cards"。期間は出さない） --- */
  .works__cards {
    display: grid;
    /* 375px 幅でも溢れないよう min() で下限を頭打ちにする */
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 14px;
    align-items: stretch;
  }

  .works__card {
    display: flex;
    flex-direction: column;
    padding: 26px 26px 24px;
    background: var(--works-surface, var(--c-bg));
    border: 1px solid var(--line-mid);
    border-radius: var(--radius-sm);
    transition:
      border-color 250ms var(--ease),
      box-shadow 250ms var(--ease),
      transform 250ms var(--ease);
  }

  .works__card:hover {
    border-color: color-mix(in srgb, var(--c-accent) 50%, transparent);
    box-shadow: 0 8px 22px rgba(22, 25, 28, 0.07);
    transform: translateY(-2px);
  }

  .works__card[hidden] {
    display: none;
  }

  .works__card .works__client {
    margin-top: 10px;
    font-size: 1rem;
    line-height: 1.6;
  }

  /* 本文で高さを吸収して、タグを下端に揃える */
  .works__card .works__body {
    flex: 1;
    margin-top: 14px;
    font-size: 0.84375rem;
  }

  .works__card .works__tags {
    margin-top: 20px;
  }

  .works__category {
    font-size: 0.65625rem;
    letter-spacing: 0.18em;
    color: var(--c-accent);
  }

  .works__client {
    margin-top: 9px;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .works__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .works__tag {
    font-size: 0.6875rem;
    line-height: 1;
    padding: 5px 9px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--c-accent) 8%, transparent);
    color: var(--c-accent);
  }

  .works__body {
    font-size: 0.875rem;
    line-height: 1.95;
    color: var(--c-text);
  }

  .works__duration {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }

  .works__months {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .works__period {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--ink-40);
    white-space: nowrap;
  }

  .works__period.is-ongoing {
    color: var(--c-accent);
  }

  .works__track {
    margin-top: 13px;
    height: 6px;
    border-radius: 3px;
    background: rgba(22, 25, 28, 0.08);
    overflow: hidden;
  }

  .works__bar {
    height: 100%;
    width: 0;
    border-radius: 3px;
    background: color-mix(in srgb, var(--c-accent) 55%, transparent);
    transition: width 1100ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .works__bar.is-ongoing {
    background: var(--c-accent);
  }

  .works__empty {
    margin-top: 20px;
    font-size: 0.875rem;
    color: var(--ink-55);
  }

  .works__empty[hidden] {
    display: none;
  }

  .works__footnote {
    margin-top: 28px;
    font-size: 0.84375rem;
    line-height: 2;
    color: var(--ink-50);
    max-width: 44em;
  }

  .works__footnote:first-of-type {
    margin-top: 34px;
  }

  @media (max-width: 980px) {
    .works__row {
      grid-template-columns: minmax(0, 1fr) minmax(200px, 0.9fr);
      gap: 20px 28px;
    }

    .works__body {
      grid-column: 1 / -1;
      order: 3;
    }
  }

  @media (max-width: 736px) {
    .works__stats {
      grid-template-columns: minmax(0, 1fr);
    }

    .works__filters {
      padding: 24px 20px 26px;
    }

    .works__row {
      grid-template-columns: minmax(0, 1fr);
      padding: 22px 20px;
      gap: 18px;
    }

    .works__card {
      padding: 22px 20px 20px;
    }
  }
</style>

<script>
  /**
   * WORKS セクションの動き。
   * ・分類チップでの絞り込み（表示件数も更新する）
   * ・画面に入ったら数値のカウントアップと期間バーの伸長を1回だけ再生する
   */
  const play = (root: HTMLElement) => {
    root.querySelectorAll<HTMLElement>('[data-bar]').forEach((bar, i) => {
      setTimeout(() => {
        bar.style.width = `${bar.dataset.bar}%`
      }, 60 * i)
    })

    root.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => {
      const target = Number(el.dataset.countup)
      const duration = 1200
      const start = performance.now()
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / duration)
        el.textContent = String(
          Math.round(target * (1 - Math.pow(1 - progress, 3)))
        )
        if (progress < 1) requestAnimationFrame(tick)
      }
      requestAnimationFrame(tick)
    })
  }

  const wireFilters = (root: HTMLElement) => {
    /* layout="rows" の .works__row と layout="cards" の .works__card の両方 */
    const rows = [...root.querySelectorAll<HTMLElement>('[data-ind]')]
    const chips = [...root.querySelectorAll<HTMLElement>('[data-filter]')]
    const counter = root.querySelector<HTMLElement>('[data-works-count]')
    const empty = root.querySelector<HTMLElement>('[data-works-empty]')

    const apply = (filter: string) => {
      const [kind, value] = filter.split(':')
      let shown = 0

      for (const row of rows) {
        const match =
          kind === 'all' ||
          (kind === 'ind' && row.dataset.ind === value) ||
          (kind === 'tag' &&
            (row.dataset.tags ?? '').split('|').includes(value))
        row.hidden = !match
        if (match) shown++
      }

      if (counter) counter.textContent = `${shown} / ${rows.length}`
      if (empty) empty.hidden = shown > 0
      for (const chip of chips) {
        chip.classList.toggle(
          'is-on',
          kind !== 'all' && chip.dataset.filter === filter
        )
      }
    }

    for (const chip of chips) {
      chip.addEventListener('click', () =>
        apply(chip.dataset.filter ?? 'all:all')
      )
    }
  }

  document.querySelectorAll<HTMLElement>('[data-works]').forEach((root) => {
    wireFilters(root)

    if (!('IntersectionObserver' in window)) {
      play(root)
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          play(root)
          observer.disconnect()
        }
      },
      { threshold: 0 }
    )
    observer.observe(root)
  })
</script>
