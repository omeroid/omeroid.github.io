---
import Section from '~/components/ui/Section.astro'
import SectionHead from '~/components/ui/SectionHead.astro'
import type {
  SectionHeading,
  Surface,
  WorkFilterLabels,
  WorkRow,
  WorkStat,
} from '~/types'

/**
 * WORKS（実績）。IT事業・コンサルティングで、それぞれの実績を渡して使う。
 *
 * layout で見せ方が2種類ある。
 * ・rows  … 1件1行。支援期間の数値と期間バーを並べる（IT・システム開発）
 * ・cards … カードのグリッド。期間は出さない（コンサルティング）
 *
 * 絞り込みは filterLabels.groups の軸数だけ自動で組み立てる。
 * ・filterMode="multi" … 軸ごとに1つ選んでAND条件で絞る。枠は開閉式で、
 *                        閉じているときは選択中の条件を要約で見せる（IT）
 * ・filterMode="single"… どこか1つだけ選べる。枠は開いたまま（コンサル。既定）
 * perPage を渡すとページ送りが付く（渡さなければ全件を一度に出す）。
 */
interface Props {
  heading: SectionHeading
  layout?: 'rows' | 'cards'
  stats: WorkStat[]
  /** legend（期間バーの凡例）は layout="rows" のみ */
  listHeading: { title: string; legend?: string; range: string }
  filterLabels: WorkFilterLabels
  filterMode?: 'single' | 'multi'
  /** 1ページの件数。省略するとページ送りなし */
  perPage?: number
  works: WorkRow[]
  /** 絞り込みで0件になったときの文言 */
  emptyText?: string
  footnotes: string[]
  /** 乗せる面の色。数値タイル・絞り込み枠・カードは常に反対色になる */
  surface?: Surface
}

const {
  heading: worksHeading,
  layout = 'rows',
  stats: workStats,
  listHeading: worksListHeading,
  filterLabels: worksFilterLabels,
  filterMode = 'single',
  perPage,
  works,
  emptyText = '該当するプロジェクトがありません。',
  footnotes: worksFootnotes,
  surface = 'bg',
} = Astro.props

/** 期間バーの基準になる最長プロジェクト */
const maxMonths = Math.max(...works.map((w) => w.months ?? 0), 1)

/** 90 → 7年6ヶ月 / 9 → 9ヶ月 */
const duration = (months: number) =>
  months < 12
    ? `${months}ヶ月`
    : `${Math.floor(months / 12)}年${months % 12}ヶ月`

/** 継続中は ONGOING、終了済みは年の範囲 */
const period = (row: WorkRow) =>
  row.end === undefined
    ? 'ONGOING'
    : row.end === row.start
      ? `${row.start}`
      : `${row.start} — ${row.end}`

type FilterField = WorkFilterLabels['groups'][number]['field']

/** 1行がその軸で持っている値。単数のフィールドも配列に揃える */
const valuesOf = (row: WorkRow, field: FilterField): string[] => {
  const value = row[field]
  if (value === undefined) return []
  return Array.isArray(value) ? value : [value]
}

/**
 * 絞り込みの軸ごとに、選択肢と件数を作る。
 * order があればその並び、なければ件数の多い順（同数は先に出てきた方）。
 */
const groups = worksFilterLabels.groups
  .map((group) => {
    const counts = new Map<string, number>()
    for (const row of works) {
      for (const value of valuesOf(row, group.field)) {
        counts.set(value, (counts.get(value) ?? 0) + 1)
      }
    }
    const items = [...counts].map(([name, count], i) => ({ name, count, i }))
    items.sort((a, b) =>
      group.order
        ? group.order.indexOf(a.name) - group.order.indexOf(b.name)
        : b.count - a.count || a.i - b.i
    )
    return { ...group, items }
  })
  /* 値を1つも持たない軸（コンサルには無い技術など）は出さない */
  .filter((group) => group.items.length > 0)

/** 行に軸ごとの値を data 属性で持たせる。JS 側は data-f-<軸> を見る */
const rowAttrs = (row: WorkRow) =>
  Object.fromEntries(
    groups.map((group) => [
      `data-f-${group.field.toLowerCase()}`,
      valuesOf(row, group.field).join('|'),
    ])
  )

const isMulti = filterMode === 'multi'
---

<Section variant={surface === 'alt' ? 'alt' : 'default'} bordered>
  <SectionHead {...worksHeading} gap="clamp(2.5rem, 1.5rem + 3vw, 4rem)" />

  <div
    class="works"
    data-works
    data-works-mode={filterMode}
    data-works-per-page={perPage}
    style={`--works-surface:var(${surface === 'alt' ? '--c-bg-alt-cool' : '--c-bg'})`}
  >
    <div
      class="works__stats"
      data-reveal="3"
      style={`--works-stat-cols:${workStats.length}`}
    >
      {
        workStats.map((stat) => (
          <div class:list={['works__stat', stat.featured && 'is-featured']}>
            <div class="en works__stat-label">{stat.label}</div>
            <div class="works__stat-value">
              <span class="en works__stat-num" data-countup={stat.value}>
                {stat.value}
              </span>
              {stat.suffix && (
                <span class="en works__stat-suffix">{stat.suffix}</span>
              )}
              <span class="works__stat-unit">{stat.unit}</span>
              {stat.value2 !== undefined && (
                <>
                  <span
                    class="en works__stat-num is-sub"
                    data-countup={stat.value2}
                  >
                    {stat.value2}
                  </span>
                  <span class="works__stat-unit">{stat.unit2}</span>
                </>
              )}
            </div>
            <div class="works__stat-note">{stat.note}</div>
          </div>
        ))
      }
    </div>

    <div class="works__list-head" data-reveal="4">
      <h3 class="works__list-title">{worksListHeading.title}</h3>
      <div class="en works__legend">
        {
          worksListHeading.legend && (
            <span class="works__legend-item">
              <span class="works__legend-bar" />
              {worksListHeading.legend}
            </span>
          )
        }
        <span>
          {worksListHeading.legend && '／ '}{worksListHeading.range}
        </span>
      </div>
    </div>

    <div class:list={['works__filters', isMulti && 'is-multi']} data-reveal="4">
      <div class="works__filters-head">
        <div class="works__filters-lead">
          {worksFilterLabels.lead}
          {
            worksFilterLabels.leadNote && (
              <span class="works__filters-note">
                {worksFilterLabels.leadNote}
              </span>
            )
          }
          <span class="en works__count" data-works-count>
            {works.length} / {works.length}
          </span>
          {isMulti && <span class="works__summary" data-works-summary />}
        </div>
        <div class="works__filters-actions">
          <button
            type="button"
            class:list={['works__chip', 'is-all', !isMulti && 'is-on']}
            data-works-reset
          >
            {worksFilterLabels.all}
          </button>
          {
            isMulti && (
              <button
                type="button"
                class="works__chip works__toggle"
                aria-expanded="false"
                data-works-toggle
                data-open={worksFilterLabels.open}
                data-close={worksFilterLabels.close}
              >
                <span data-works-toggle-label>{worksFilterLabels.open}</span>
                <span class="works__toggle-icon" />
              </button>
            )
          }
        </div>
      </div>

      <div class="works__filter-groups" data-works-groups>
        {
          groups.map((group) => (
            <div class="works__filter-group">
              <div class="works__filter-label">
                <span class="en">
                  {group.no} ／ {group.label}{' '}
                  <span class="is-wide">{group.en}</span>
                </span>
                <span class="works__rule" />
              </div>
              <div class="works__chips">
                {group.items.map((item) => (
                  <button
                    type="button"
                    class="works__chip"
                    data-works-chip
                    data-g={group.field.toLowerCase()}
                    data-v={item.name}
                  >
                    {item.name}
                    <span class="en works__chip-count">{item.count}</span>
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {
      layout === 'rows' ? (
        <div class="works__rows" data-works-list data-reveal="5">
          {works.map((row) => (
            <article class="works__row" data-work-row {...rowAttrs(row)}>
              <div>
                <div class="en works__category">{row.category}</div>
                <h4 class="works__client">{row.client}</h4>
                <div class="works__tags">
                  {row.tags.map((tag) => (
                    <span class="works__tag">{tag}</span>
                  ))}
                  {(row.techs ?? []).map((tech) => (
                    <span class="en works__tech">{tech}</span>
                  ))}
                </div>
              </div>
              <div class="works__col-body">
                <p class="works__body">{row.body}</p>
                {(row.phase?.length || row.dealFlow || row.contract) && (
                  <div class="works__meta">
                    {row.phase && row.phase.length > 0 && (
                      <span>{row.phase.join(' ／ ')}</span>
                    )}
                    {(row.dealFlow || row.contract) && (
                      <span>
                        {[row.dealFlow, row.contract]
                          .filter(Boolean)
                          .join(' ／ ')}
                      </span>
                    )}
                  </div>
                )}
              </div>
              <div>
                <div class="works__duration">
                  <span class="works__months">{duration(row.months ?? 0)}</span>
                  <span
                    class:list={[
                      'en',
                      'works__period',
                      row.end === undefined && 'is-ongoing',
                    ]}
                  >
                    {period(row)}
                  </span>
                </div>
                <div class="works__track">
                  <div
                    class:list={[
                      'works__bar',
                      row.end === undefined && 'is-ongoing',
                    ]}
                    data-bar={Math.round(((row.months ?? 0) / maxMonths) * 100)}
                  />
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="works__cards" data-works-list data-reveal="5">
          {works.map((row) => (
            <article class="works__card" data-work-row {...rowAttrs(row)}>
              <div class="en works__category">{row.category}</div>
              <h4 class="works__client">{row.client}</h4>
              {row.background || row.approach || row.outcome ? (
                <div class="works__flow">
                  {row.background && (
                    <div class="works__flow-step">
                      <span class="works__flow-label">背景・課題</span>
                      <p class="works__flow-body">{row.background}</p>
                    </div>
                  )}
                  {row.approach && (
                    <div class="works__flow-step">
                      <span class="works__flow-label">アプローチ</span>
                      <p class="works__flow-body">{row.approach}</p>
                    </div>
                  )}
                  {row.outcome && (
                    <div class="works__flow-step">
                      <span class="works__flow-label">成果</span>
                      <p class="works__flow-body">{row.outcome}</p>
                    </div>
                  )}
                </div>
              ) : (
                <p class="works__body">{row.body}</p>
              )}
              <div class="works__tags">
                {row.tags.map((tag) => (
                  <span class="works__tag">{tag}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      perPage && (
        <div class="works__pager" data-works-pager hidden>
          <button
            type="button"
            class="works__page-btn"
            data-works-page="prev"
            aria-label="前のページ"
          >
            ← 前へ
          </button>
          <div class="works__pagenums" data-works-pagenums />
          <button
            type="button"
            class="works__page-btn"
            data-works-page="next"
            aria-label="次のページ"
          >
            次へ →
          </button>
        </div>
      )
    }

    <div class="works__empty" data-works-empty hidden>{emptyText}</div>

    {
      worksFootnotes.map((note, i) => (
        <p class="works__footnote" data-reveal={6 + i}>
          {note}
        </p>
      ))
    }
  </div>
</Section>
<style>
  /* --- 数値タイル --- */
  .works__stats {
    display: grid;
    grid-template-columns: repeat(var(--works-stat-cols, 3), minmax(0, 1fr));
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .works__stat {
    background: var(--works-surface, var(--c-bg));
    padding: 34px 30px 30px;
  }

  .works__stat.is-featured {
    background: var(--c-accent);
    color: var(--c-bg);
  }

  .works__stat-label {
    font-size: 0.65625rem;
    letter-spacing: 0.2em;
    color: var(--ink-45);
  }

  .works__stat.is-featured .works__stat-label {
    color: color-mix(in srgb, var(--c-bg) 60%, transparent);
  }

  .works__stat-value {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 18px;
  }

  .works__stat-num {
    font-size: var(--fs-stat);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .works__stat-num.is-sub {
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
  }

  .works__stat-suffix {
    font-size: clamp(1.375rem, 0.95rem + 1.7vw, 2rem);
    font-weight: 500;
    line-height: 1;
  }

  .works__stat-unit {
    font-size: 0.9375rem;
    color: var(--ink-55);
  }

  .works__stat.is-featured .works__stat-unit {
    color: color-mix(in srgb, var(--c-bg) 72%, transparent);
  }

  .works__stat-note {
    margin-top: 14px;
    font-size: var(--fs-xs);
    line-height: 1.9;
    color: var(--c-text);
  }

  .works__stat.is-featured .works__stat-note {
    color: color-mix(in srgb, var(--c-bg) 80%, transparent);
  }

  /* --- 一覧の見出し --- */
  .works__list-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin: clamp(3rem, 2rem + 3vw, 5.5rem) 0 26px;
  }

  .works__list-title {
    font-family: var(--font-head);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .works__legend {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--ink-45);
  }

  .works__legend-item {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .works__legend-bar {
    width: 22px;
    height: 6px;
    border-radius: 3px;
    background: var(--c-accent);
    display: block;
  }

  /* --- 絞り込み --- */
  .works__filters {
    margin-bottom: 34px;
    padding: 30px 32px 32px;
    background: var(--works-surface, var(--c-bg));
    border: 1px solid var(--line-mid);
    border-radius: var(--radius);
  }

  .works__filters-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .works__filters.is-multi .works__filters-head {
    margin-bottom: 26px;
  }

  .works__filters-lead {
    font-size: 0.875rem;
    color: var(--c-text);
  }

  .works__filters-note {
    margin-left: 10px;
    font-size: var(--fs-xs);
    color: var(--ink-45);
  }

  .works__count {
    margin-left: 12px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-45);
  }

  /* 枠を閉じているときだけ出す、選択中の条件の要約 */
  .works__summary {
    margin-left: 12px;
    font-size: var(--fs-xs);
    color: var(--c-accent);
  }

  .works__summary[hidden] {
    display: none;
  }

  .works__filters-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .works__toggle-icon {
    display: block;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 250ms var(--ease);
  }

  .works__toggle[aria-expanded='true'] .works__toggle-icon {
    transform: rotate(-135deg);
  }

  .works__filter-groups {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* multi は開閉するので、閉じた高さに向けて畳めるようにしておく */
  .works__filters.is-multi .works__filter-groups {
    gap: 28px;
    overflow: hidden;
    transition:
      max-height 380ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 280ms var(--ease);
  }

  .works__filter-label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.65625rem;
    letter-spacing: 0.18em;
    color: var(--ink-45);
    white-space: nowrap;
  }

  .works__filter-label .is-wide {
    letter-spacing: 0.22em;
  }

  .works__rule {
    flex: 1;
    height: 1px;
    background: var(--line-mid);
    display: block;
  }

  .works__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }

  .works__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    font-size: var(--fs-xs);
    line-height: 1;
    color: var(--c-text);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease),
      border-color 200ms var(--ease);
  }

  .works__chip:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .works__chip.is-all {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .works__chip.is-all:hover {
    background: color-mix(in srgb, var(--c-accent) 8%, transparent);
  }

  .works__chip.is-on {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-bg);
  }

  .works__chip-count {
    font-size: 0.6875rem;
    opacity: 0.5;
  }

  /* --- 実績の行 --- */
  .works__rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .works__row {
    display: grid;
    grid-template-columns:
      minmax(210px, 1fr) minmax(240px, 1.45fr)
      minmax(200px, 0.9fr);
    align-items: center;
    gap: 32px;
    padding: 26px 30px;
    background: var(--works-surface, var(--c-bg));
    border: 1px solid var(--line-mid);
    border-radius: var(--radius-sm);
    transition:
      border-color 250ms var(--ease),
      box-shadow 250ms var(--ease),
      transform 250ms var(--ease);
  }

  .works__row:hover {
    border-color: color-mix(in srgb, var(--c-accent) 50%, transparent);
    box-shadow: 0 8px 22px rgba(22, 25, 28, 0.07);
    transform: translateY(-2px);
  }

  .works__row[hidden] {
    display: none;
  }

  /* --- 実績のカード（layout="cards"。期間は出さない） --- */
  .works__cards {
    display: grid;
    /* 375px 幅でも溢れないよう min() で下限を頭打ちにする */
    grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr));
    gap: 14px;
    align-items: stretch;
  }

  .works__card {
    display: flex;
    flex-direction: column;
    padding: 26px 26px 24px;
    background: var(--works-surface, var(--c-bg));
    border: 1px solid var(--line-mid);
    border-radius: var(--radius-sm);
    transition:
      border-color 250ms var(--ease),
      box-shadow 250ms var(--ease),
      transform 250ms var(--ease);
  }

  .works__card:hover {
    border-color: color-mix(in srgb, var(--c-accent) 50%, transparent);
    box-shadow: 0 8px 22px rgba(22, 25, 28, 0.07);
    transform: translateY(-2px);
  }

  .works__card[hidden] {
    display: none;
  }

  .works__card .works__client {
    margin-top: 10px;
    font-size: 1rem;
    line-height: 1.6;
  }

  /* 本文で高さを吸収して、タグを下端に揃える */
  .works__card .works__body {
    flex: 1;
    margin-top: 14px;
    font-size: 0.84375rem;
  }

  .works__card .works__tags {
    margin-top: 20px;
  }

  /* 構造化本文（背景・課題 → アプローチ → 成果）。cards のフロー表示 */
  .works__flow {
    flex: 1;
    margin-top: 18px;
    display: flex;
    flex-direction: column;
  }

  .works__flow-step {
    position: relative;
    border: 1px solid var(--line-mid);
    border-radius: var(--radius-sm);
    padding: 17px 15px 14px;
  }

  /* 2つめ以降のステップは、矢印を置くぶんの余白を上に取る */
  .works__flow-step + .works__flow-step {
    margin-top: 26px;
  }

  /* ラベルは枠の上辺に重ねたタブにする */
  .works__flow-label {
    position: absolute;
    top: 0;
    left: 13px;
    transform: translateY(-50%);
    padding: 2px 9px;
    background: var(--works-surface, var(--c-bg));
    border: 1px solid var(--line-mid);
    border-radius: 3px;
    font-size: 0.65625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--c-accent);
    white-space: nowrap;
  }

  .works__flow-body {
    font-size: 0.84375rem;
    line-height: 1.85;
    color: var(--c-text);
  }

  /* ステップ間をつなぐ下向きの矢印（ファネル） */
  .works__flow-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -18px;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 13px solid transparent;
    border-right: 13px solid transparent;
    border-top: 10px solid color-mix(in srgb, var(--c-accent) 32%, transparent);
  }

  .works__category {
    font-size: 0.65625rem;
    letter-spacing: 0.18em;
    color: var(--c-accent);
  }

  .works__client {
    margin-top: 9px;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .works__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .works__tag {
    font-size: 0.6875rem;
    line-height: 1;
    padding: 5px 9px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--c-accent) 8%, transparent);
    color: var(--c-accent);
  }

  /* 技術は塗りのテーマチップと区別して線のチップにする */
  .works__tech {
    font-size: 0.6875rem;
    line-height: 1;
    padding: 5px 9px;
    border: 1px solid var(--line-mid);
    border-radius: 3px;
    color: var(--ink-55);
  }

  /* フェーズ・商流・契約形態を本文の下に添える */
  .works__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 12px;
    font-size: 0.71875rem;
    color: var(--ink-50);
  }

  .works__meta > span {
    white-space: nowrap;
  }

  .works__body {
    font-size: 0.875rem;
    line-height: 1.95;
    color: var(--c-text);
  }

  .works__duration {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }

  .works__months {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .works__period {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--ink-40);
    white-space: nowrap;
  }

  .works__period.is-ongoing {
    color: var(--c-accent);
  }

  .works__track {
    margin-top: 13px;
    height: 6px;
    border-radius: 3px;
    background: rgba(22, 25, 28, 0.08);
    overflow: hidden;
  }

  .works__bar {
    height: 100%;
    width: 0;
    border-radius: 3px;
    background: color-mix(in srgb, var(--c-accent) 55%, transparent);
    transition: width 1100ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .works__bar.is-ongoing {
    background: var(--c-accent);
  }

  /* ページ送りで戻ってくる位置。sticky ヘッダーに隠れない分だけずらす */
  .works__rows,
  .works__cards {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  /* --- ページ送り --- */
  .works__pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 34px;
  }

  .works__pager[hidden] {
    display: none;
  }

  .works__page-btn,
  .works__pagenum {
    font-size: var(--fs-xs);
    line-height: 1;
    color: var(--c-text);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease),
      border-color 200ms var(--ease),
      opacity 200ms var(--ease);
  }

  .works__page-btn {
    display: inline-flex;
    align-items: center;
    padding: 11px 18px;
    white-space: nowrap;
  }

  .works__page-btn:hover:not(:disabled),
  .works__pagenum:hover:not(.is-on) {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .works__page-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .works__pagenums {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .works__pagenum {
    font-family: var(--font-en);
    min-width: 34px;
    height: 34px;
    font-size: 0.8125rem;
  }

  .works__pagenum.is-on {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-bg);
  }

  /* --- 該当0件 --- */
  .works__empty {
    margin-top: 12px;
    padding: 44px 30px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    text-align: center;
    font-size: 0.875rem;
    color: var(--ink-50);
  }

  .works__empty[hidden] {
    display: none;
  }

  .works__footnote {
    margin-top: 28px;
    font-size: 0.84375rem;
    line-height: 2;
    color: var(--ink-50);
    max-width: 44em;
  }

  .works__footnote:first-of-type {
    margin-top: 34px;
  }

  @media (max-width: 980px) {
    .works__row {
      grid-template-columns: minmax(0, 1fr) minmax(200px, 0.9fr);
      gap: 20px 28px;
    }

    .works__col-body {
      grid-column: 1 / -1;
      order: 3;
    }
  }

  @media (max-width: 736px) {
    .works__stats {
      grid-template-columns: minmax(0, 1fr);
    }

    .works__filters {
      padding: 24px 20px 26px;
    }

    .works__row {
      grid-template-columns: minmax(0, 1fr);
      padding: 22px 20px;
      gap: 18px;
    }

    .works__card {
      padding: 22px 20px 20px;
    }

    .works__pager {
      gap: 12px;
    }

    .works__page-btn {
      padding: 11px 12px;
    }

    .works__empty {
      padding: 32px 20px;
    }
  }
</style>

<script>
  /**
   * WORKS セクションの動き。
   * ・絞り込み（filterMode="multi" は軸ごとに1つ選んでAND条件、single はどこか1つだけ）
   * ・perPage を渡している場合のページ送り
   * ・画面に入ったら数値のカウントアップと期間バーの伸長を1回だけ再生する
   */
  const play = (root: HTMLElement) => {
    root.querySelectorAll<HTMLElement>('[data-bar]').forEach((bar, i) => {
      setTimeout(() => {
        bar.style.width = `${bar.dataset.bar}%`
      }, 60 * i)
    })

    root.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => {
      const target = Number(el.dataset.countup)
      const duration = 1200
      const start = performance.now()
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / duration)
        el.textContent = String(
          Math.round(target * (1 - Math.pow(1 - progress, 3)))
        )
        if (progress < 1) requestAnimationFrame(tick)
      }
      requestAnimationFrame(tick)
    })
  }

  const wireFilters = (root: HTMLElement) => {
    const isMulti = root.dataset.worksMode === 'multi'
    const perPage = Number(root.dataset.worksPerPage) || 0

    /* layout="rows" の .works__row と layout="cards" の .works__card の両方 */
    const rows = [...root.querySelectorAll<HTMLElement>('[data-work-row]')]
    if (!rows.length) return

    const chips = [...root.querySelectorAll<HTMLElement>('[data-works-chip]')]
    const reset = root.querySelector<HTMLElement>('[data-works-reset]')
    const counter = root.querySelector<HTMLElement>('[data-works-count]')
    const summary = root.querySelector<HTMLElement>('[data-works-summary]')
    const empty = root.querySelector<HTMLElement>('[data-works-empty]')
    const groupsBox = root.querySelector<HTMLElement>('[data-works-groups]')
    const toggle = root.querySelector<HTMLButtonElement>('[data-works-toggle]')
    const toggleLabel = root.querySelector<HTMLElement>(
      '[data-works-toggle-label]'
    )
    const list = root.querySelector<HTMLElement>('[data-works-list]')
    const pager = root.querySelector<HTMLElement>('[data-works-pager]')
    const pageNums = root.querySelector<HTMLElement>('[data-works-pagenums]')
    const prevBtn = root.querySelector<HTMLButtonElement>(
      '[data-works-page="prev"]'
    )
    const nextBtn = root.querySelector<HTMLButtonElement>(
      '[data-works-page="next"]'
    )

    /** 軸（data-g）ごとに選んでいる値。未選択の軸はキーを持たない */
    const active = new Map<string, string>()
    let page = 1
    let open = false

    /** 開いている間は中身の高さに追従させる（チップの折り返しが変わるため） */
    const resize = () => {
      if (open && groupsBox)
        groupsBox.style.maxHeight = `${groupsBox.scrollHeight}px`
    }

    const setOpen = (next: boolean) => {
      if (!groupsBox || !toggle) return
      open = next
      groupsBox.style.maxHeight = open ? `${groupsBox.scrollHeight}px` : '0px'
      groupsBox.style.opacity = open ? '1' : '0'
      toggle.setAttribute('aria-expanded', String(open))
      if (toggleLabel) {
        toggleLabel.textContent =
          (open ? toggle.dataset.close : toggle.dataset.open) ?? ''
      }
      if (summary) summary.hidden = open
    }

    const apply = () => {
      const matched = rows.filter((row) =>
        [...active].every(([field, value]) =>
          (row.getAttribute(`data-f-${field}`) ?? '').split('|').includes(value)
        )
      )

      const pages = perPage
        ? Math.max(1, Math.ceil(matched.length / perPage))
        : 1
      if (page > pages) page = pages
      const visible = perPage
        ? matched.slice((page - 1) * perPage, page * perPage)
        : matched

      for (const row of rows) row.hidden = !visible.includes(row)

      if (counter) counter.textContent = `${matched.length} / ${rows.length}`
      if (empty) empty.hidden = matched.length > 0

      if (summary) {
        const selected = [...active.values()]
        summary.textContent = selected.length ? selected.join('・') : '条件なし'
      }

      for (const chip of chips) {
        chip.classList.toggle(
          'is-on',
          active.get(chip.dataset.g ?? '') === chip.dataset.v
        )
      }
      /* single の「すべて表示」だけは未選択のとき塗る（multi のリセットは常に線） */
      if (reset && !isMulti) {
        reset.classList.toggle('is-on', active.size === 0)
      }

      if (pager) pager.hidden = !perPage || matched.length <= perPage
      if (pageNums) {
        pageNums.textContent = ''
        for (let i = 1; i <= pages; i++) {
          const btn = document.createElement('button')
          btn.type = 'button'
          btn.className = i === page ? 'works__pagenum is-on' : 'works__pagenum'
          btn.textContent = String(i)
          btn.addEventListener('click', () => goToPage(i))
          pageNums.append(btn)
        }
      }
      if (prevBtn) prevBtn.disabled = page === 1
      if (nextBtn) nextBtn.disabled = page === pages

      resize()
    }

    /**
     * ページを切り替えて一覧の先頭に戻す。
     * 行が入れ替わって高さが変わるので、位置を明示しないとブラウザのスクロール位置がずれる。
     * behavior を指定しないのは、global.css の scroll-behavior（reduce 設定時は auto）に従わせるため。
     */
    const goToPage = (next: number) => {
      page = next
      apply()
      list?.scrollIntoView({ block: 'start' })
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const field = chip.dataset.g ?? ''
        const value = chip.dataset.v ?? ''
        const wasOn = active.get(field) === value
        /* single はどこか1つだけなので、他の軸の選択も落とす */
        if (!isMulti) active.clear()
        if (wasOn) active.delete(field)
        else active.set(field, value)
        page = 1
        apply()
      })
    }

    reset?.addEventListener('click', () => {
      active.clear()
      page = 1
      apply()
    })

    prevBtn?.addEventListener('click', () => {
      if (page > 1) goToPage(page - 1)
    })

    nextBtn?.addEventListener('click', () => goToPage(page + 1))

    toggle?.addEventListener('click', () => setOpen(!open))
    window.addEventListener('resize', resize)

    apply()
    /* multi は畳んだ状態から始める（single は開いたまま） */
    if (isMulti) setOpen(false)
  }

  document.querySelectorAll<HTMLElement>('[data-works]').forEach((root) => {
    wireFilters(root)

    if (!('IntersectionObserver' in window)) {
      play(root)
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          play(root)
          observer.disconnect()
        }
      },
      { threshold: 0 }
    )
    observer.observe(root)
  })
</script>
