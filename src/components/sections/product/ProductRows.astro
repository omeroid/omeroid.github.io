---
import ArrowLink from '~/components/ui/ArrowLink.astro'
import Picture from '~/components/ui/Picture.astro'
import { products } from '~/data/product'
---

<section class="section section--bordered">
  <div class="container products">
    {
      products.map((product, i) => (
        <article
          class:list={['products__row', product.reverse && 'is-reverse']}
          data-reveal={i}
        >
          <Picture
            picture={product.picture}
            height="clamp(220px, 26vw, 340px)"
            radius="10px"
            class="products__pic"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <div class="products__body">
            <div class="en products__label">{product.label}</div>
            <h2 class="products__title">{product.title}</h2>
            <p class="products__text">{product.body}</p>
            {product.href && (
              <ArrowLink href={product.href} class="products__link">
                {product.linkLabel ?? '詳細を見る'}
              </ArrowLink>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .products {
    padding-block: var(--section-y);
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 2rem + 5vw, 6rem);
  }

  .products__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 3.5vw, 4rem);
    align-items: center;
  }

  .products__row.is-reverse :global(.products__pic) {
    order: 2;
  }

  .products__label {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.22em;
    color: var(--ink-50);
  }

  .products__title {
    margin-top: 20px;
    font-family: var(--font-head);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.125rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.5;
  }

  .products__text {
    margin-top: 22px;
    font-size: 1rem;
    line-height: 2.1;
    color: var(--c-text);
    max-width: 30em;
  }

  /* 子コンポーネント（ArrowLink）の要素なのでスコープを抜ける必要がある */
  .products__body :global(.products__link) {
    margin-top: 28px;
  }

  @media (max-width: 900px) {
    .products__row,
    .products__row.is-reverse {
      grid-template-columns: minmax(0, 1fr);
    }

    .products__row.is-reverse :global(.products__pic) {
      order: 0;
    }
  }
</style>
