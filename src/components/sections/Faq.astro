---
import Eyebrow from '~/components/ui/Eyebrow.astro'
import { faqHeading } from '~/data/faq'
import type { Faq, Surface } from '~/types'

/** よくあるご質問。設問はページごとに差し替える */
interface Props {
  items: Faq[]
  /** 乗せる面の色。ページ側の交互配色に合わせる */
  surface?: Surface
}

const { items, surface = 'bg' } = Astro.props
---

<section
  class:list={[
    'section',
    'section--bordered',
    surface === 'alt' && 'section--alt',
  ]}
>
  <div class="container faq">
    <div class="faq__head">
      <Eyebrow label={faqHeading.eyebrow} reveal={0} />
      <h2 class="heading faq__title" data-reveal="1">
        {
          faqHeading.title.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </h2>
    </div>

    <dl class="faq__list">
      {
        items.map((faq, i) => (
          <div class="faq__row" data-reveal={2 + i}>
            <div class="en faq__no">Q{i + 1}</div>
            <div>
              <dt class="faq__q">{faq.question}</dt>
              <dd class="faq__a">{faq.answer}</dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-y);
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 72px;
    align-items: start;
  }

  .faq__head {
    position: sticky;
    top: calc(var(--header-h) + 36px);
  }

  .faq__title {
    margin-top: 32px;
    font-size: var(--fs-h2-sm);
    line-height: 1.62;
  }

  .faq__list {
    border-top: 1px solid var(--line-mid);
  }

  .faq__row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 20px;
    padding: 34px 8px;
    border-bottom: 1px solid var(--line-mid);
    transition: background-color 260ms var(--ease);
  }

  .faq__row:hover {
    background: rgb(var(--c-teal-rgb) / 0.06);
  }

  .faq__no {
    font-size: 0.9375rem;
    color: var(--c-accent);
  }

  .faq__q {
    font-family: var(--font-head);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3125rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  .faq__a {
    margin: 16px 0 0;
    font-size: var(--fs-body);
    line-height: 2.1;
    color: var(--c-text);
  }

  @media (max-width: 980px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .faq__head {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .faq__row {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 12px;
      padding-inline: 0;
    }
  }
</style>
