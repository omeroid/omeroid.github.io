---
import Btn from '~/components/ui/Btn.astro'
import Eyebrow from '~/components/ui/Eyebrow.astro'
import InsightList from '~/components/ui/InsightList.astro'
import Section from '~/components/ui/Section.astro'
import {
  consultingInsightCount,
  consultingInsightsHeading,
  insights,
} from '~/data/insights'
import type { Surface } from '~/types'

/** CONTENTS（コンサルティング記事）。コンサルティングページで使う */
interface Props {
  /** 乗せる面の色。ページ側の交互配色に合わせる */
  surface?: Surface
}

const { surface = 'bg' }: Props = Astro.props

/** 記事は新しい順に先頭から数件だけ。全件は /insights/ に置く */
const latest = insights.slice(0, consultingInsightCount)
---

<Section variant={surface === 'alt' ? 'alt-cool' : 'default'} bordered>
  <div class="contents__insights-head">
    <div>
      <Eyebrow label={consultingInsightsHeading.eyebrow} reveal={0} />
      <h2 class="heading contents__insights-title" data-reveal="1">
        {consultingInsightsHeading.title}
      </h2>
      <p class="contents__insights-lead" data-reveal="2">
        {consultingInsightsHeading.lead}
      </p>
    </div>
    <Btn
      href="/insights/"
      variant="outline"
      arrow
      reveal={3}
      class="contents__insights-cta"
    >
      コンサルティング記事一覧を見る
    </Btn>
  </div>

  <InsightList items={latest} revealFrom={4} />
</Section>

<style>
  .contents__insights-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .contents__insights-title {
    margin-top: 26px;
    font-size: var(--fs-h2);
  }

  .contents__insights-lead {
    margin-top: 18px;
    max-width: 620px;
    font-size: var(--fs-body);
    line-height: 2;
    color: var(--c-text);
    text-wrap: pretty;
  }

  /* 子コンポーネント（Btn）の要素なのでスコープを抜ける必要がある */
  .contents__insights-head :global(.contents__insights-cta) {
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .contents__insights-head {
      align-items: flex-start;
    }
  }
</style>
