---
import ArrowLink from '~/components/ui/ArrowLink.astro'
import Picture from '~/components/ui/Picture.astro'
import Section from '~/components/ui/Section.astro'
import SectionHead from '~/components/ui/SectionHead.astro'
import { consultingContents } from '~/data/consulting'
---

<Section flush="top">
  <SectionHead
    {...consultingContents.heading}
    gap="clamp(2.5rem, 1.5rem + 3vw, 3.5rem)"
  />

  <div class="grid grid--2 contents">
    {
      consultingContents.items.map((item, i) => (
        <a
          class="contents__card"
          href={item.href}
          target="_blank"
          rel="noopener"
          data-reveal={2 + i}
        >
          <Picture
            picture={item.picture}
            height="clamp(200px, 24vw, 280px)"
            radius="var(--radius)"
          />
          <h3 class="contents__title">{item.title}</h3>
          <p class="contents__body">{item.body}</p>
          <ArrowLink size="sm" class="contents__link">
            詳細を見る
          </ArrowLink>
        </a>
      ))
    }
  </div>
</Section>

<style>
  .contents {
    gap: 28px;
  }

  .contents__card {
    display: block;
    color: inherit;
  }

  .contents__card:hover {
    color: inherit;
  }

  .contents__title {
    margin-top: 26px;
    font-family: var(--font-head);
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5625rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  .contents__body {
    margin-top: 14px;
    font-size: var(--fs-body);
    line-height: 2;
    color: var(--c-text);
  }

  /* 子コンポーネント（ArrowLink）の要素なのでスコープを抜ける必要がある */
  .contents__card :global(.contents__link) {
    margin-top: 20px;
  }
</style>
