---
import Section from '~/components/ui/Section.astro'
import SectionHead from '~/components/ui/SectionHead.astro'
import StackIcon from '~/components/ui/StackIcon.astro'
import { accentStyle } from '~/lib/accent'
import { stackFootnote, stackGroups, stackHeading } from '~/data/stack'
---

<Section bordered>
  <SectionHead {...stackHeading} />

  <div class="grid grid--4 stack">
    {
      stackGroups.map((group, i) => (
        <div
          class="stack__group"
          style={`${accentStyle(group.accent)};--tint-cover:var(--c-bg)`}
          data-reveal={3 + i}
          data-tint
        >
          <span class="tint-layer" />
          <div class="en stack__label">{group.label}</div>
          <ul class="stack__list">
            {group.items.map((item) => (
              <li class="stack__item">
                {item.icon ? (
                  <StackIcon icon={item.icon} dark={item.darkIcon} size={22} />
                ) : item.fallback === 'server' ? (
                  <span class="stack__server" aria-hidden="true">
                    <span />
                    <span />
                    <span />
                  </span>
                ) : (
                  <span class="en stack__abbr" aria-hidden="true">
                    {item.name.slice(0, 3)}
                  </span>
                )}
                <span class="en">{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <p class="stack__footnote" data-reveal="7">{stackFootnote}</p>
</Section>

<style>
  .stack__group {
    position: relative;
    isolation: isolate;
    padding: clamp(1.75rem, 1.2rem + 1.6vw, 2.375rem)
      clamp(1.375rem, 1rem + 1.4vw, 2.125rem);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: linear-gradient(
      158deg,
      rgb(var(--accent-rgb) / 0.16) 0%,
      rgb(var(--accent-rgb) / 0) 56%
    );
  }

  .stack__label {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.2em;
    color: var(--ink-50);
    margin-bottom: 24px;
  }

  .stack__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-family: var(--font-en);
    font-size: 1rem;
  }

  .stack__item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .stack__abbr {
    width: 22px;
    height: 22px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ink-30);
    border-radius: 4px;
    font-size: 0.5625rem;
    letter-spacing: 0.02em;
  }

  .stack__server {
    width: 22px;
    height: 22px;
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }

  .stack__server span {
    width: 16px;
    height: 5px;
    border: 1px solid var(--ink-45);
    border-radius: 1px;
    display: block;
  }

  .stack__footnote {
    margin-top: 24px;
    font-size: 0.875rem;
    color: var(--ink-55);
  }
</style>
