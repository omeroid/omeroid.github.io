---
import Section from '~/components/ui/Section.astro'
import SectionHead from '~/components/ui/SectionHead.astro'
import { companyRows } from '~/data/company'
---

<Section flush="top">
  <SectionHead
    eyebrow="COMPANY DATA"
    title="会社概要"
    size="sm"
    gap="clamp(2rem, 1.4rem + 2vw, 2.75rem)"
  />

  <dl class="table">
    {
      companyRows.map((row, i) => (
        <div class="table__row" data-reveal={2 + i}>
          <dt class="en table__label">{row.label}</dt>
          <dd class="table__value">
            {row.value.map((line, j) => (
              <>
                {j > 0 && <br />}
                {line}
              </>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .table {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line-mid);
  }

  .table__row {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 24px;
    padding: 26px 8px;
    border-bottom: 1px solid var(--line-mid);
    font-size: 1rem;
  }

  .table__label {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--ink-45);
    padding-top: 4px;
  }

  .table__value {
    margin: 0;
    line-height: 2;
  }

  @media (max-width: 736px) {
    .table__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      padding-inline: 0;
    }
  }
</style>
