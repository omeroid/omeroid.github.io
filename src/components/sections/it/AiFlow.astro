---
import Section from '~/components/ui/Section.astro'
import SectionHead from '~/components/ui/SectionHead.astro'
import { gradientBarStyle } from '~/lib/accent'
import { itAiFlowHeading, itAiFlowNote, itAiFlowSteps } from '~/data/it'
import type { Surface } from '~/types'

/** AI-FLOW（AI駆動の開発フロー）。IT事業ページで使う */
interface Props {
  /** 乗せる面の色。ページ側の交互配色に合わせる */
  surface?: Surface
}

const { surface = 'alt' }: Props = Astro.props
---

<Section variant={surface === 'alt' ? 'alt-cool' : 'default'} bordered>
  <SectionHead
    {...itAiFlowHeading}
    gap="clamp(2.5rem, 1rem + 3.8vw, 3.75rem)"
  />

  <ol class="flow" style={`--steps:${itAiFlowSteps.length}`}>
    {
      itAiFlowSteps.map((step, i) => (
        <li class="flow__item" data-reveal={3 + i}>
          <div class="flow__bar" style={gradientBarStyle(step.from, step.to)} />
          <div class="en flow__step">{step.step}</div>
          <h3 class="flow__title">{step.title}</h3>
          <p class="flow__body">{step.body}</p>
        </li>
      ))
    }
  </ol>

  <p class="flow__note" data-reveal={3 + itAiFlowSteps.length}>
    {itAiFlowNote}
  </p>
</Section>

<style>
  .flow {
    display: grid;
    grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    gap: 24px;
  }

  .flow__bar {
    height: 4px;
    border-radius: 2px;
    margin-bottom: 26px;
  }

  .flow__step {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--ink-45);
  }

  .flow__title {
    margin-top: 16px;
    font-family: var(--font-head);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3125rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  .flow__body {
    margin-top: 14px;
    font-size: 0.875rem;
    line-height: 2;
    color: var(--c-text);
  }

  .flow__note {
    margin-top: clamp(2.75rem, 1.5rem + 3vw, 4.5rem);
    padding: clamp(1.5rem, 1.1rem + 1.2vw, 2rem)
      clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    font-size: 0.875rem;
    line-height: 2;
    color: var(--c-text);
  }

  @media (max-width: 1100px) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 24px;
    }
  }

  @media (max-width: 560px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
