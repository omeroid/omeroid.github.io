---
import CardGrid from '~/components/ui/CardGrid.astro'
import Section from '~/components/ui/Section.astro'
import SectionHead from '~/components/ui/SectionHead.astro'
import type { AccentCard, SectionHeading } from '~/types'

/** STRENGTH（選ばれている4つの理由）。IT事業・コンサルティングで使う */
interface Props {
  heading: SectionHeading
  cards: AccentCard[]
}

const { heading, cards } = Astro.props
---

<Section bordered>
  <SectionHead {...heading} gap="clamp(2.5rem, 1rem + 3.5vw, 3.5rem)" />
  <CardGrid cards={cards} cols={2} titleSize="lg" />
</Section>
