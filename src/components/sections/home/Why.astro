---
import ArrowLink from '~/components/ui/ArrowLink.astro'
import Eyebrow from '~/components/ui/Eyebrow.astro'
import Logo from '~/components/ui/Logo.astro'
import { why } from '~/data/home'
---

<section class="section">
  <div class="container why">
    <div class="why__body">
      <Eyebrow label={why.eyebrow} reveal={0} />
      <h2 class="heading why__title" data-reveal="1">
        {
          why.title.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </h2>
      {
        why.paragraphs.map((text, i) => (
          <p class="lead why__text" data-reveal={2 + i}>
            {text}
          </p>
        ))
      }
      <ArrowLink href={why.link.href} class="why__link" reveal={4}>
        {why.link.label}
      </ArrowLink>
    </div>

    <div class="why__visual" data-reveal="2" aria-hidden="true">
      <div class="why__blobs">
        <span class="why__blob why__blob--a"></span>
        <span class="why__blob why__blob--b"></span>
        <span class="why__blob why__blob--c"></span>
      </div>
      <div class="why__overlay">
        <span class="why__ripple"></span>
        <span class="why__ripple why__ripple--delay"></span>
        <span class="why__core"></span>
        <Logo height="auto" class="why__logo" />
        <span class="en why__label why__label--left"
          >{why.orbitLabels.left}</span
        >
        <span class="en why__label why__label--right"
          >{why.orbitLabels.right}</span
        >
        <span class="en why__label why__label--bottom"
          >{why.orbitLabels.bottom}</span
        >
      </div>
    </div>
  </div>
</section>

<style>
  .why {
    padding-block: var(--section-y);
    display: grid;
    /* 見出しを意図した2行で収めるため、テキスト側を少し広く取る */
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2.5rem, 1rem + 5vw, 5.5rem);
    align-items: center;
  }

  .why__title {
    margin-top: 32px;
    font-size: var(--fs-h2);
    line-height: 1.72;
  }

  .why__text {
    margin-top: 28px;
    max-width: 32em;
  }

  /* 子コンポーネント（ArrowLink）の要素なのでスコープを抜ける必要がある */
  .why__body :global(.why__link) {
    margin-top: 40px;
  }

  /* --- 中央のロゴを囲むビジュアル --- */
  .why__visual {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .why__blobs {
    position: absolute;
    inset: 8%;
    filter: blur(2px);
  }

  .why__blob {
    position: absolute;
    width: 56%;
    height: 56%;
    border-radius: 50%;
    mix-blend-mode: multiply;
    display: block;
  }

  .why__blob--a {
    left: 4%;
    top: 16%;
    background: var(--c-orange);
    opacity: 0.55;
    animation: omeFloatA 18s ease-in-out infinite;
  }

  .why__blob--b {
    left: 38%;
    top: 8%;
    background: var(--c-teal);
    opacity: 0.55;
    animation: omeFloatB 22s ease-in-out infinite;
  }

  .why__blob--c {
    left: 20%;
    top: 40%;
    background: var(--c-blue);
    opacity: 0.5;
    animation: omeFloatC 26s ease-in-out infinite;
  }

  .why__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .why__ripple {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    border: 1px solid rgba(22, 25, 28, 0.28);
    animation: omeRipple 4.6s ease-out infinite;
    display: block;
  }

  .why__ripple--delay {
    animation-delay: 2.3s;
  }

  .why__core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 35%,
      rgba(255, 214, 168, 0.75) 0%,
      rgba(178, 236, 222, 0.5) 42%,
      rgba(180, 200, 246, 0.28) 68%,
      rgba(251, 250, 247, 0) 100%
    );
    filter: blur(6px);
    mix-blend-mode: screen;
    animation: omeCore 5.2s ease-in-out infinite;
    display: block;
  }

  .why__visual :global(.why__logo) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: clamp(90px, 12vw, 130px);
    height: auto;
    color: var(--c-ink);
    animation: omeLogoPulse 5.2s ease-in-out infinite;
  }

  .why__label {
    position: absolute;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.2em;
    color: var(--ink-62);
    white-space: nowrap;
  }

  .why__label--left {
    left: 9%;
    top: 26%;
  }

  .why__label--right {
    right: 7%;
    top: 20%;
  }

  .why__label--bottom {
    left: 50%;
    bottom: 8%;
    transform: translateX(-50%);
  }

  @media (max-width: 900px) {
    .why {
      grid-template-columns: minmax(0, 1fr);
    }

    .why__visual {
      order: -1;
      max-width: 460px;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
