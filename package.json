{
  "name": "gatsby-starter-forty-v2",
  "description": "Gatsby Starter - Forty V2",
  "version": "1.0.0",
  "author": "Hunter Chang",
  "dependencies": {
    "@fontsource-variable/noto-serif-jp": "^5.0.2",
    "classnames": "^2.3.2",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "gatsby": "^5.14.5",
    "gatsby-plugin-google-gtag": "^5.14.0",
    "gatsby-plugin-manifest": "^5.14.0",
    "gatsby-plugin-sass": "^6.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "sass": "^1.89.1"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "scripts": {
    "build": "NODE_NO_WARNINGS=1 gatsby build",
    "develop": "NODE_NO_WARNINGS=1 gatsby develop",
    "deploy": "NODE_NO_WARNINGS=1 gatsby build --prefix-paths && echo 'www.omeroid.com' > public/CNAME && gh-pages --branch master -d public",
    "start": "yarn develop",
    "clean": "NODE_NO_WARNINGS=1 gatsby clean",
    "serve": "NODE_NO_WARNINGS=1 gatsby serve",
    "format": "prettier --write --single-quote \"src/**/*.js\"",
    "format:check": "prettier --check --single-quote \"src/**/*.js\"",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "test": "echo \"Write tests! -> https://gatsby.app/unit-testing\"",
    "test:ci": "yarn test"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.3.0",
    "prettier": "^3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby-starter-default"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "postcss": "^8.4.31",
    "cookie": "^0.7.0",
    "path-to-regexp": "^0.1.12",
    "lodash.template": "^4.18.1"
  }
}
