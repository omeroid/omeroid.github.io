{
  "name": "omeroid-corporate-site",
  "description": "omeroid株式会社 コーポレートサイト (Astro / SSG)",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "scripts": {
    "dev": "astro dev",
    "develop": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "astro preview",
    "typecheck": "astro check",
    "check:styles": "node scripts/check-scoped-styles.mjs",
    "sync:works": "node scripts/generate-consulting-works.mjs",
    "lint": "node scripts/check-scoped-styles.mjs && astro check",
    "format": "prettier --write \"src/**/*.{astro,ts,js,css,json}\" \"*.{mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,js,css,json}\" \"*.{mjs,json,md}\"",
    "clean": "rm -rf dist .astro node_modules/.astro",
    "deploy": "astro build && gh-pages --branch master --dotfiles -d dist",
    "test": "astro check",
    "test:ci": "astro check"
  },
  "dependencies": {
    "astro": "^5.6.1",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "gh-pages": "^6.3.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "simple-icons": "^16.28.0",
    "typescript": "^5.8.3"
  }
}
